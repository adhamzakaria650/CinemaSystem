@using CinemaSystem.ViewModels.Movie
@model MoviesVM
@section Styles {
    <style>
        .filters {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: flex-end;
        }

            .filters .form-group {
                margin: 0;
                min-width: 200px;
            }
        /* Poster thumbnail (portrait) */
        .movie-thumb {
            display: block;
            width: 56px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--line);
            background: var(--bg);
        }

            .movie-thumb.none {
                display: grid;
                place-items: center;
                text-align: center;
                color: var(--muted);
                font-size: 11px;
            }

        /* Date + time on two lines */
        .when {
            white-space: nowrap;
        }

            .when small {
                display: block;
                color: var(--muted);
            }

        /* Actor chips */
        .chips {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            min-width: 180px;
            max-width: 280px;
        }

        .chip {
            padding: 3px 10px;
            border-radius: 999px;
            background: var(--bg);
            border: 1px solid var(--line);
            font-size: 12px;
            white-space: nowrap;
        }

            .chip.more {
                color: var(--muted);
            }

        .muted {
            color: var(--muted);
        }

        .pagination {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 6px;
            list-style: none;
            margin: 24px 0 0;
            padding: 0;
        }

            .pagination .page-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 40px;
                height: 40px;
                padding: 0 14px;
                border: 1px solid var(--line);
                border-radius: 8px;
                background: var(--surface);
                color: var(--text);
                font-weight: 500;
                text-decoration: none;
                transition: background .15s, border-color .15s, color .15s;
            }

            .pagination .page-item:not(.active):not(.disabled) .page-link:hover {
                background: var(--bg);
                border-color: var(--accent);
            }

            .pagination .page-item.active .page-link {
                background: var(--accent);
                border-color: var(--accent);
                color: var(--accent-ink);
                font-weight: 600;
            }

            .pagination .page-item.disabled .page-link {
                opacity: .4;
                cursor: not-allowed;
                pointer-events: none;
            }

            .pagination .page-link:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 2px;
            }

        .empty {
            text-align: center;
            padding: 40px 0;
            color: var(--muted);
        }
    </style>
}

<div class="page-head">
    <p style="margin:0;color:var(--muted)">@Model.movies.Count() movies</p>
    <a class="btn btn-primary" href="/Admin/Movies/Create">Add movie</a>
</div>

<!-- Filters -->
<form method="get" class="card filters" style="margin-bottom:18px">
    <div class="form-group">
        <label for="name">Name</label>
        <input id="name" name="Name" class="form-control" placeholder="Search by name" />
    </div>
    <div class="form-group">
        <label for="MinPrice">Min Price</label>
        <input type="number" id="MinPrice" name="MinPrice" class="form-control" placeholder="Search by Min Price" />
    </div>
    <div class="form-group">
        <label for="MaxPrice">Max Price</label>
        <input id="MaxPrice" name="MaxPrice" class="form-control" placeholder="Search by Max Price" />
    </div>
    <div class="form-group">
    <label for="categories">Categories</label>
    <select id="categories" name="CategoryId" class="form-control">
        @foreach(var c in Model.categories)
            {
                <option value=@c.Id>@c.Name</option>   
            }
    </select>
    </div>
    <div class="form-group">
        <label for="cinemas">Cinemas</label>
        <select id="cinemas" name="CinemaId" class="form-control">
        @foreach(var c in Model.cinemas)
            {
                <option value=@c.Id>@c.Name</option>   
            }
    </select>
    </div>
    <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="Status" class="form-control">
            <option value="">All</option>
            <option value="true">Active</option>
            <option value="false">Inactive</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Filter</button>
    <a class="btn" href="/Admin/Movies/Index">Clear</a>
</form>

<!-- Table -->
<div class="card">
    @if (Model.movies.Count() == 0)
    {
        <div class="empty">
            No movies match your filters.
            <a href="/Admin/Movies/Index">Clear filters</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Image</th>
                        <th>Category</th>
                        <th>Cinema</th>
                        <th>Price</th>
                        <th>Date &amp; time</th>
                        <th>Actors</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.movies)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td>@c.Name</td>
                            <td>
                                @if (!string.IsNullOrEmpty(c.MainImg))
                                {
                                    <img class="movie-thumb" src="~/images/@c.MainImg" alt="@c.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span class="movie-thumb none">No image</span>
                                }
                            </td>
                            <td>@c.category.Name</td>
                            <td>@c.cinema.Name</td>
                            <td>@c.Price</td>
                            <td class="when">
                                @c.Time.ToString("dd MMM yyyy")
                                <small>@c.Time.ToString("hh:mm tt")</small>
                            </td>
                            <td>
                                @if (Model.actorMovies != null && Model.actorMovies.Count()>0)
                                {
                                    <div class="chips">
                                        @foreach (var a in Model.actorMovies)
                                        {
                                            if (a.MovieID == c.Id)
                                            {
                                                <span class="chip">@a.actor.Name</span>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="muted">No actors</span>
                                }
                            </td>
                            <td>
                                @if (c.Status)
                                {
                                    <span class="badge badge-ok">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-err">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    <a href="/Admin/Movies/Update/@c.Id" class="btn btn-sm">Edit</a>
                                    <a href="/Admin/Movies/Delete/@c.Id" class="btn btn-sm btn-danger"
                                       data-confirm="Delete movie “@c.Name”?">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Pagination -->
<nav aria-label="Movies pagination">
    <ul class="pagination">
        @if (ViewBag.currentPage > 1)
        {
            <li class="page-item"><a href="/Admin/Movies/Index?page=@(ViewBag.currentPage - 1)" class="page-link">Previous</a></li>
        }
        else
        {
            <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a></li>
        }
        @for (int i = 1; i <= ViewBag.totalPages; i++)
        {
            if (i == ViewBag.currentPage)
            {
                <li class="page-item active">
                    <a class="page-link" href="#" aria-current="page">@i</a>
                </li>
            }
            else
            {
                <li class="page-item"><a class="page-link" href="/Admin/Movies/Index?page=@i">@i</a></li>
            }
        }
        @if (ViewBag.currentPage < ViewBag.totalPages)
        {
            <li class="page-item"><a href="/Admin/Movies/Index?page=@(ViewBag.currentPage + 1)" class="page-link">Next</a></li>
        }
        else
        {
            <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true">Next</a></li>
        }
    </ul>
</nav>