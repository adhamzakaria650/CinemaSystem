@model List<Cinema>
@section Styles {
    <style>
        .filters {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: flex-end;
        }

            .filters .form-group {
                margin: 0;
                min-width: 200px;
            }

        .cinema-thumb {
            display: block;
            width: 84px;
            height: 56px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--line);
            background: var(--bg);
        }

            .cinema-thumb.none {
                display: grid;
                place-items: center;
                color: var(--muted);
                font-size: 12px;
            }

        .pagination {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 6px;
            list-style: none;
            margin: 24px 0 0;
            padding: 0;
        }

            .pagination .page-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 40px;
                height: 40px;
                padding: 0 14px;
                border: 1px solid var(--line);
                border-radius: 8px;
                background: var(--surface);
                color: var(--text);
                font-weight: 500;
                text-decoration: none;
                transition: background .15s, border-color .15s, color .15s;
            }

            .pagination .page-item:not(.active):not(.disabled) .page-link:hover {
                background: var(--bg);
                border-color: var(--accent);
            }

            .pagination .page-item.active .page-link {
                background: var(--accent);
                border-color: var(--accent);
                color: var(--accent-ink);
                font-weight: 600;
            }

            .pagination .page-item.disabled .page-link {
                opacity: .4;
                cursor: not-allowed;
                pointer-events: none;
            }

            .pagination .page-link:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 2px;
            }

        .empty {
            text-align: center;
            padding: 40px 0;
            color: var(--muted);
        }
    </style>
}

<div class="page-head">
    <p style="margin:0;color:var(--muted)">@Model.Count() cinemas</p>
    <a class="btn btn-primary" href="/Admin/Cinemas/Create">Add cinema</a>
</div>

<!-- Filters -->
<form method="get" class="card filters" style="margin-bottom:18px">
    <div class="form-group">
        <label for="name">Name</label>
        <input id="name" name="Name" class="form-control" placeholder="Search by name" />
    </div>
    <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="Status" class="form-control">
            <option value="">All</option>
            <option value="true">Active</option>
            <option value="false">Inactive</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Filter</button>
    <a class="btn" href="/Admin/Cinemas/Index">Clear</a>
</form>

<!-- Table -->
<div class="card">
    @if (Model.Count() == 0)
    {
        <div class="empty">
            No cinemas match your filters.
            <a href="/Admin/Cinemas/Index">Clear filters</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Image</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td>@c.Name</td>
                            <td>
                                @if (!string.IsNullOrEmpty(c.Image))
                                {
                                    <img class="cinema-thumb" src="~/images/@c.Image" alt="@c.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span class="cinema-thumb none">No image</span>
                                }
                            </td>
                            <td>
                                @if (c.Status)
                                {
                                    <span class="badge badge-ok">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-err">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    <a href="/Admin/Cinemas/Update/@c.Id" class="btn btn-sm">Edit</a>
                                    <a href="/Admin/Cinemas/Delete/@c.Id" class="btn btn-sm btn-danger"
                                       data-confirm="Delete cinema “@c.Name”?">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Pagination -->
<nav aria-label="Cinemas pagination">
    <ul class="pagination">
        @if (ViewBag.currentPage > 1)
        {
            <li class="page-item"><a href="/Admin/Cinemas/Index?page=@(ViewBag.currentPage - 1)" class="page-link">Previous</a></li>
        }
        else
        {
            <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a></li>
        }
        @for (int i = 1; i <= ViewBag.totalPages; i++)
        {
            if (i == ViewBag.currentPage)
            {
                <li class="page-item active">
                    <a class="page-link" href="#" aria-current="page">@i</a>
                </li>
            }
            else
            {
                <li class="page-item"><a class="page-link" href="/Admin/Cinemas/Index?page=@i">@i</a></li>
            }
        }
        @if (ViewBag.currentPage < ViewBag.totalPages)
        {
            <li class="page-item"><a href="/Admin/Cinemas/Index?page=@(ViewBag.currentPage + 1)" class="page-link">Next</a></li>
        }
        else
        {
            <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1" aria-disabled="true">Next</a></li>
        }
    </ul>
</nav>