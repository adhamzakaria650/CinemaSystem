@model CinemaSystem.ViewModels.Identity.ResetPasswordVM

@{
    ViewData["Title"] = "ResetPassword";
}

<style>
    /* The page's own container becomes a centered card.
           :has(> .row) targets only this inner container, not the layout's outer one. */
    .container:has(> .row) {
        width: 100%;
        max-width: 480px;
        margin: 24px auto;
        padding: 32px;
        background: var(--surface, #1a1a27);
        border: 1px solid var(--line, #2d2d42);
        border-radius: 14px;
        color: var(--text, #ececf6);
    }

        .container:has(> .row) h1 {
            margin: 0 0 4px;
            font-size: 30px;
            line-height: 1.2;
            overflow-wrap: anywhere;
        }

        .container:has(> .row) h4 {
            margin: 0;
            font-size: 15px;
            font-weight: 400;
            color: var(--muted, #9a9cb5);
            overflow-wrap: anywhere;
        }

        .container:has(> .row) hr {
            margin: 20px 0 24px;
            border: 0;
            border-top: 1px solid var(--line, #2d2d42);
            opacity: 1;
        }

        .container:has(> .row) .row {
            display: block;
            margin: 0;
        }

        .container:has(> .row) .col-md-12 {
            width: 100%;
            padding: 0;
        }

    /* Form */
    .form-group {
        margin-bottom: 16px;
    }

    .control-label {
        display: block;
        margin-bottom: 6px;
        font-size: 14px;
        font-weight: 500;
    }

    .container:has(> .row) .form-control {
        display: block;
        width: 100%;
        height: 44px;
        padding: 0 14px;
        border: 1px solid var(--line, #2d2d42);
        border-radius: 8px;
        background: var(--bg, #0f0f17);
        color: var(--text, #ececf6);
        font: inherit;
        transition: border-color .15s, box-shadow .15s;
    }

        .container:has(> .row) .form-control:focus {
            outline: none;
            border-color: var(--accent, #e8b64c);
            box-shadow: 0 0 0 3px rgba(232, 182, 76, .25);
        }

        /* Keep browser autofill dark instead of white/yellow */
        .container:has(> .row) .form-control:-webkit-autofill {
            -webkit-text-fill-color: var(--text, #ececf6);
            box-shadow: 0 0 0 1000px var(--bg, #0f0f17) inset;
        }

    /* Validation */
    .container:has(> .row) .input-validation-error {
        border-color: #c8434f;
    }

    .container:has(> .row) .text-danger {
        display: block;
        margin-top: 4px;
        color: #ff8a93;
        font-size: 13px;
    }

    .validation-summary-valid {
        display: none;
    }

    .validation-summary-errors {
        margin-bottom: 16px;
        padding: 12px 16px;
        border: 1px solid #c8434f;
        border-radius: 8px;
        background: rgba(200, 67, 79, .12);
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

    /* Submit button */
    .container:has(> .row) .mt-3 {
        margin-top: 1.25rem;
    }

    .container:has(> .row) input[type="submit"] {
        width: 100%;
        min-height: 46px;
        padding: 0 16px;
        border: 1px solid var(--accent, #e8b64c);
        border-radius: 8px;
        background: var(--accent, #e8b64c);
        color: var(--accent-ink, #2a2005);
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        transition: filter .15s;
    }

        .container:has(> .row) input[type="submit"]:hover {
            filter: brightness(.93);
        }

        .container:has(> .row) input[type="submit"]:focus-visible {
            outline: 2px solid var(--accent, #e8b64c);
            outline-offset: 2px;
        }

    /* "Back to Login" link under the form */
    .container:has(> .row) > div:last-child {
        margin-top: 20px;
        text-align: center;
    }

        .container:has(> .row) > div:last-child a {
            color: var(--accent, #e8b64c);
            font-weight: 600;
            text-decoration: none;
        }

            .container:has(> .row) > div:last-child a:hover {
                text-decoration: underline;
            }

    @@media (max-width: 520px) {
        .container:has(> .row) {
            margin: 8px auto;
            padding: 22px 18px;
        }

            .container:has(> .row) h1 {
                font-size: 26px;
            }
    }
</style>

<div class="container">
    <h1>ResetPassword</h1>

    <h4>ResetPassword</h4>
    <hr />
    <div class="row">
        <div class="col-md-12">
            <form asp-action="ResetPassword">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="UserId" hidden />
                <input asp-for="Token" hidden />
                <div class="form-group">
                    <label asp-for="Password" class="control-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="control-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="form-group mt-3">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>

    <div>
        <a asp-action="Login">Back to Login</a>
    </div>

</div>

<script>
    // Focus the first field with an error, or the first visible field on a fresh page
    (function () {
        var target = document.querySelector(".input-validation-error") ||
            document.querySelector("form .form-control");
        if (target) target.focus();
    })();
</script>