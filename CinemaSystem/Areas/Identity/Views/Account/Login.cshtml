@model CinemaSystem.ViewModels.Identity.LoginVM

@{
	ViewData["Title"] = "Login";
}

<style>
	.container:has(> .row) {
		width: 100%;
		max-width: 440px;
		margin: 24px auto;
		padding: 32px;
		background: var(--surface, #1a1a27);
		border: 1px solid var(--line, #2d2d42);
		border-radius: 14px;
		color: var(--text, #ececf6);
	}

		.container:has(> .row) h1 {
			margin: 0 0 4px;
			font-size: 30px;
			line-height: 1.2;
		}

		.container:has(> .row) h4 {
			margin: 0;
			font-size: 15px;
			font-weight: 400;
			color: var(--muted, #9a9cb5);
		}

		.container:has(> .row) hr {
			margin: 20px 0 24px;
			border: 0;
			border-top: 1px solid var(--line, #2d2d42);
			opacity: 1;
		}

		.container:has(> .row) .row {
			display: block;
			margin: 0;
		}

		.container:has(> .row) .col-md-4 {
			width: 100%;
			max-width: 100%;
			padding: 0;
		}

	.form-group {
		margin-bottom: 16px;
	}

	.control-label {
		display: block;
		margin-bottom: 6px;
		font-size: 14px;
		font-weight: 500;
	}

	.container:has(> .row) .form-control {
		display: block;
		width: 100%;
		height: 44px;
		padding: 0 14px;
		border: 1px solid var(--line, #2d2d42);
		border-radius: 8px;
		background: var(--bg, #0f0f17);
		color: var(--text, #ececf6);
		font: inherit;
		transition: border-color .15s, box-shadow .15s;
	}

		.container:has(> .row) .form-control:focus {
			outline: none;
			border-color: var(--accent, #e8b64c);
			box-shadow: 0 0 0 3px rgba(232, 182, 76, .25);
		}

		.container:has(> .row) .form-control:-webkit-autofill {
			-webkit-text-fill-color: var(--text, #ececf6);
			box-shadow: 0 0 0 1000px var(--bg, #0f0f17) inset;
		}

	.container:has(> .row) .form-group:has(input[type="checkbox"]) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 10px;
	}

		.container:has(> .row) .form-group:has(input[type="checkbox"]) .control-label {
			order: 2;
			margin: 0;
			cursor: pointer;
		}

	.container:has(> .row) input[type="checkbox"].form-control {
		order: 1;
		width: 20px;
		height: 20px;
		padding: 0;
		margin: 0;
		cursor: pointer;
		accent-color: var(--accent, #e8b64c);
	}

	.container:has(> .row) .form-group:has(input[type="checkbox"]) .text-danger {
		order: 3;
		flex-basis: 100%;
	}

	.container:has(> .row) .input-validation-error {
		border-color: #c8434f;
	}

	.container:has(> .row) .text-danger {
		display: block;
		margin-top: 4px;
		color: #ff8a93;
		font-size: 13px;
	}

	.validation-summary-valid {
		display: none;
	}

	.validation-summary-errors {
		margin-bottom: 16px;
		padding: 12px 16px;
		border: 1px solid #c8434f;
		border-radius: 8px;
		background: rgba(200, 67, 79, .12);
	}

		.validation-summary-errors ul {
			margin: 0;
			padding-left: 18px;
		}

	.container:has(> .row) .mt-3 {
		margin-top: 1.25rem;
	}

	.container:has(> .row) input[type="submit"] {
		width: 100%;
		height: 46px;
		border: 1px solid var(--accent, #e8b64c);
		border-radius: 8px;
		background: var(--accent, #e8b64c);
		color: var(--accent-ink, #2a2005);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
		transition: filter .15s;
	}

		.container:has(> .row) input[type="submit"]:hover {
			filter: brightness(.93);
		}

		.container:has(> .row) input[type="submit"]:focus-visible {
			outline: 2px solid var(--accent, #e8b64c);
			outline-offset: 2px;
		}

	.container:has(> .row) > div:not(.row) {
		margin-top: 10px;
		text-align: center;
		font-size: 14px;
	}

		.container:has(> .row) > div:not(.row) a {
			color: var(--muted, #9a9cb5);
			text-decoration: none;
			transition: color .15s;
		}

			.container:has(> .row) > div:not(.row) a:hover {
				color: var(--accent, #e8b64c);
				text-decoration: underline;
			}

	.container:has(> .row) > div:nth-of-type(2) {
		margin-top: 22px;
		font-size: 15px;
	}

		.container:has(> .row) > div:nth-of-type(2) a {
			color: var(--accent, #e8b64c);
			font-weight: 600;
		}

	@@media (max-width: 520px) {
		.container:has(> .row) {
			margin: 8px auto;
			padding: 22px 18px;
		}

			.container:has(> .row) h1 {
				font-size: 26px;
			}
	}
</style>

<div class="container">
	<h1>Login</h1>

	<h4>Login</h4>
	<hr />
	<div class="row">
		<div class="col-md-4">
			<form asp-action="Login">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>

				<div class="form-group">
					<label asp-for="UserNameOrEmail" class="control-label"></label>
					<input asp-for="UserNameOrEmail" class="form-control" />
					<span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
				</div>

				<div class="form-group">
					<label asp-for="Password" class="control-label"></label>
					<input asp-for="Password" class="form-control" />
					<span asp-validation-for="Password" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label asp-for="RememberMe" class="control-label"></label>
					<input type="checkbox" asp-for="RememberMe" class="form-control" />
					<span asp-validation-for="RememberMe" class="text-danger"></span>
				</div>
				<div class="form-group mt-3">
					<input type="submit" value="Login" class="btn btn-primary" />
				</div>
			</form>
		</div>
	</div>

	<div>
		<a asp-action="Register">Register</a>
	</div>
	<div>
		<a asp-action="ResendEmailConfirmation">ResendEmailConfirmation</a>
	</div>
	<div>
		<a asp-action="ForgetPassword">ForgetPassword</a>
	</div>
</div>

<script>
	(function () {
		var target = document.querySelector(".input-validation-error") ||
			document.querySelector("form .form-control");
		if (target) target.focus();
	})();
</script>
